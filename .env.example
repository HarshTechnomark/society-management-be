# Copy to .env and fill in. Validated at start-up by src/lib/env.ts.
# Each module adds its own variables when it is built (see the module documents).
NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://societyapp:societyapp_dev@127.0.0.1:3307/societyapp
LOG_LEVEL=info
# One origin per app; the app is resolved from the Origin header by the first host label
# (platform, admin, my, gate, work). Use *.localhost hosts in development.
APP_ORIGINS=http://platform.localhost:3000,http://admin.localhost:3000,http://my.localhost:3000,http://gate.localhost:3000,http://work.localhost:3000
# Redis (rate limits, queues, dev inbox). Optional in development and tests: unset = in-process memory stores. Required in production.
# REDIS_URL=redis://127.0.0.1:6379
# fake = fake SMS/email adapters and a dev inbox; forbidden in production
PROVIDERS_MODE=fake
# Module 02. Generate each secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long-aaaa
JWT_REFRESH_PEPPER=change-me-at-least-32-characters-long-bbbb
AUTH_TOKEN_PEPPER=change-me-at-least-32-characters-long-cccc
# 32 random bytes in base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SocietyApp
# local = bundled list only; hibp = also call the Have I Been Pwned range API
PASSWORD_BREACH_CHECK=local
# false is allowed only when NODE_ENV=development
COOKIE_SECURE=false

# module 03 (roles and permissions): email domain required for platform team invitations
PLATFORM_TEAM_EMAIL_DOMAIN=societyapp.in
