# Test settings for `npm test` and CI. Copy to .env.test (CI does this automatically).
# Every value here is a throwaway used only by the test suite. Never use these values anywhere else.
NODE_ENV=test
PORT=4000
# Local private MySQL. CI overrides DATABASE_URL with its own service database.
DATABASE_URL=mysql://societyapp:societyapp_dev@127.0.0.1:3307/societyapp_test
LOG_LEVEL=silent
APP_ORIGINS=https://platform.societyapp.in,https://admin.societyapp.in,https://my.societyapp.in,https://gate.societyapp.in,https://work.societyapp.in
# Redis is optional: leave REDIS_URL unset to use the in-process memory stores
PROVIDERS_MODE=fake
JWT_ACCESS_SECRET=test-only-rfH2Pe-0NZAFFfgfvapSFOFymBntskUhZaQNCVNaw6CDD9Ly
JWT_REFRESH_PEPPER=test-only-ESjyKjLbINrbiOaZIN64g1Z2MLE0fEo5jWLjRwU9sCe5zhMg
AUTH_TOKEN_PEPPER=test-only-CP8XT3utBubJ2eCAWCMNOeH8yu2ma4nZnscFeZBVFbQlnW4c
TOTP_ENCRYPTION_KEY=1skiHs4zW9WWZ59S74IRyl3oy7iRZbQr1gZtNsBuQtY=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SocietyApp
PASSWORD_BREACH_CHECK=local
COOKIE_SECURE=true
PLATFORM_TEAM_EMAIL_DOMAIN=societyapp.in

# Throwaway test-only key ring for provider credentials (module 07). Never use these anywhere else.
PROVIDER_CREDENTIALS_KEYS=1:gRSx//i/snKGSOziZMKTnYQAydjPxcLyqvj5bPuKfaM=,2:Z1WWIgjEpc5mF+/UxKJK3cl5k0BCg4nJiUOEjxjusuU=
